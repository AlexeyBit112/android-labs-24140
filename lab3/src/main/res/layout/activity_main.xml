<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            style="@style/Title"
            android:text="Хранение заметки" />
        <TextView
            style="@style/Body"
            android:text="Лабораторная 3 · Задание 1" />
        <EditText
            android:id="@+id/note"
            style="@style/Field"
            android:hint="Введите заметку"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />
        <TextView
            style="@style/Body"
            android:text="SharedPreferences" />
        <Button
            android:id="@+id/save"
            style="@style/Action"
            android:text="Сохранить" />
        <Button
            android:id="@+id/load"
            style="@style/Action"
            android:text="Загрузить" />
        <Button
            android:id="@+id/clear"
            style="@style/Action"
            android:text="Очистить" />
        <TextView
            style="@style/Body"
            android:text="Приватный файл my_note.txt" />
        <Button
            android:id="@+id/saveFile"
            style="@style/Action"
            android:text="Сохранить в файл" />
        <Button
            android:id="@+id/loadFile"
            style="@style/Action"
            android:text="Загрузить из файла" />
        <TextView
            android:id="@+id/result"
            style="@style/Body"
            android:text="Здесь появится результат." />
        <Button
            android:id="@+id/list"
            style="@style/Action"
            android:text="Задание 2 · Список заметок" />
    </LinearLayout>
</ScrollView>
